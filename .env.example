# ---------------------------------------------------------------------------
# EduGuard v2 environment
# Copy this file to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Turso (libSQL) database
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 32+ random bytes, hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Used only by `npm run seed` to create the first HOD account
HOD_NAME=
HOD_EMAIL=
HOD_PASSWORD=

# Optional AI provider (Groq, Anthropic or xAI). Without a key the app uses
# its offline template.
AI_API_KEY=
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
